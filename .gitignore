# ============================================================
# TRAP — Root .gitignore
# ============================================================

# ── Environment Variables ────────────────────────────────────
.env
.env.local
.env.*.local

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
*.whl
.eggs/

# ── Python Virtual Environments ──────────────────────────────
.venv/
venv/
env/
ENV/

# ── Python type checking ─────────────────────────────────────
.mypy_cache/
.ruff_cache/

# ── pytest ───────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ── Node / npm ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Vite build output ────────────────────────────────────────
frontend/dist/
frontend/.vite/

# ── TypeScript ───────────────────────────────────────────────
*.tsbuildinfo

# ── IDE / Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── OS generated ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Alembic ──────────────────────────────────────────────────
# (keep versions/, never ignore them)

# ── Misc ─────────────────────────────────────────────────────
*.bak
*.tmp
.cache/
