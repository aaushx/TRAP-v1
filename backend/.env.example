# Database
DATABASE_URL=postgresql+asyncpg://trap_user:trap_password@localhost:5432/trap_db

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Application
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# Logo.dev Integration (Server-side Secret Key only)
LOGO_DEV_SECRET_KEY=
